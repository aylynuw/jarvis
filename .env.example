# Copy to .env and fill in. .env is never committed.
# School codes: https://open.neis.go.kr, "학교기본정보" dataset:
#   JARVIS_NEIS_OFFICE = ATPT_OFCDC_SC_CODE (education office), JARVIS_NEIS_SCHOOL = SD_SCHUL_CODE
JARVIS_NEIS_OFFICE=J10
JARVIS_NEIS_SCHOOL=
JARVIS_GRADE=1
JARVIS_CLASS=1
JARVIS_CITY=Seoul, South Korea
JARVIS_ABOUT_USER=a high-school student in Korea

# Optional
# JARVIS_NEIS_KEY=            # free key from open.neis.go.kr; without it NEIS returns at most 5 rows
# JARVIS_WAKE_THRESHOLD=0.5
# JARVIS_WHISPER_MODEL=base   # tiny / base / small
# JARVIS_VOICE=Daniel
# JARVIS_VOICE_KO=Yuna
