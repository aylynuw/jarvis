# Copy to .env and fill in. .env is never committed.
# School codes: https://open.neis.go.kr  (학교기본정보 → 시도교육청코드, 행정표준코드)
JARVIS_NEIS_OFFICE=J10
JARVIS_NEIS_SCHOOL=
JARVIS_GRADE=1
JARVIS_CLASS=1
JARVIS_CITY=Seoul, South Korea
JARVIS_ABOUT_USER=a high-school student in Korea

# Optional
# JARVIS_NEIS_KEY=            # free key from open.neis.go.kr; without it NEIS returns 5 rows max
# JARVIS_WAKE_THRESHOLD=0.5
# JARVIS_WHISPER_MODEL=base   # tiny / base / small
# JARVIS_VOICE=Daniel
# JARVIS_VOICE_KO=Yuna
